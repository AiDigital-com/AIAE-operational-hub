<?xml version="1.0" encoding="UTF-8"?>
<!--
  Self-contained event-logging-to-db-feature module. Owns the full usage-
  logging Java surface: @LogUsage, UsageAttributes, UsageEvent, UsageLogger,
  the aspect, configs, JPA entity + repository. `service` depends on this
  module so *ServiceImpl classes can carry @LogUsage; `application` picks
  it up transitively through the service edge.

  Copied from the AIAE-replit-llm-aux template (templates/generated-project/
  scaffold/backend/event-logging-to-db-feature) so the feature stays recognisable
  and removable. Only the package root, this pom's parent, and one pointcut line
  in UsageLoggingAspect differ from the template - see that class for why.

  Database migrations live in the `db` module - NOT here. This repo's `db` module
  plays the role the template calls `migrations`: it is the ONE place Liquibase
  changelogs sit, regardless of which module owns the corresponding @Entity.
  Splitting changelogs across modules hides the table-creation contract from the
  migration owner and makes cross-module Liquibase classpath includes a long-term
  footgun.

  Removal flow (in order):
    - Lightweight kill (no recompile): set `app.usage-logging.enabled=false`
      → aspect + PostgresUsageLogger drop out, NoOpUsageLogger binds, table
      stays.
    - Full removal: drop <module>event-logging-to-db-feature</module> from
      backend/pom.xml, drop the dependency line from service/pom.xml, delete
      every @LogUsage import + usage from the annotated methods, drop the
      usagelogging packages from @EntityScan/@EnableJpaRepositories in
      OperationalHubApplication, and remove the
      <include file="/db/changelog/schema/0014-usage-events.xml"/> line from
      db/src/main/resources/db/changelog/db.changelog-master.xml.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
