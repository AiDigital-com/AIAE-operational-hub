        <artifactId>AIAE-operational-hub-backend</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>operational-hub-event-logging-to-db-feature</artifactId>
    <name>Operational Hub - event-logging-to-db-feature</name>

