<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<changeSet id="add-index-hub_users-email-lower" author="gmozhaiskii">
		<preConditions onFail="MARK_RAN">
			<not>
				<indexExists tableName="hub_users" indexName="uq_hub_users_email_lower"/>
			</not>
		</preConditions>
		<sql>CREATE UNIQUE INDEX uq_hub_users_email_lower ON hub_users (lower(email));</sql>
		<rollback>
			<sql>DROP INDEX IF EXISTS uq_hub_users_email_lower;</sql>
		</rollback>
	</changeSet>

</databaseChangeLog>
