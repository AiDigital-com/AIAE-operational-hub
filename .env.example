# Runtime
PORT=5000
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oph
POSTGRES_USER=oph
POSTGRES_PASSWORD=oph

# Replit PostgreSQL usually provides PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD.
# The replit profile reads those directly and falls back to POSTGRES_*.

# Clerk / SSO
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_JWT_TEMPLATE=aidigital-api
AUTH_ALLOWED_EMAIL_DOMAIN=aidigital.com
AUTH_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5000
AUTH_ISSUER_URI=
AUTH_JWKS_URI=
AUTH_AUDIENCE=

# BigQuery
BIGQUERY_ENABLED=false
BIGQUERY_STUB_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=
BIGQUERY_LOCATION=US
BIGQUERY_IO_LINES_TABLE=silken-quasar-376417.netsuite.netsuite_campaigns_with_ids_fresh_data
BIGQUERY_RIPPLING_EMPLOYEES_TABLE=silken-quasar-376417.custom_task_data.rippling_employees
BIGQUERY_ADJUSTMENTS_VIEW=silken-quasar-376417.operational_hub.platform_mart_adjustments_view_op_hub
BIGQUERY_ADJUSTMENTS_TABLE=silken-quasar-376417.operational_hub.platform_mart_operational_hub_adjustements
BIGQUERY_CONVERSIONS_VIEW=silken-quasar-376417.operational_hub.conversions_mart_adjustments_view_op_hub
BIGQUERY_CONVERSIONS_TABLE=silken-quasar-376417.operational_hub.conversions_mart_operational_hub_adjustments
