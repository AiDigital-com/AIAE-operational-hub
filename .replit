modules = ["java-21", "nodejs-22", "postgresql-16"]
hidden  = [".idea", ".vscode", "target", "node_modules", "generated-sources", ".cache"]

[nix]
channel = "stable-24_11"

# === Deployment === Reserved VM (`gce`). Build + run wrapped in scripts.
[deployment]
deploymentTarget = "gce"
build = ["bash", "scripts/replit-build.sh"]
run   = ["bash", "scripts/replit-run.sh"]

[[ports]]
localPort = 5000
externalPort = 80

# === Workspace env ===
[env]
PORT = "5000"
SPRING_PROFILES_ACTIVE = "replit"
VITE_CLERK_JWT_TEMPLATE = "aidigital-api"

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit-dev-backend.sh"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit-dev-frontend.sh"

[agent]
expertMode = true

[userenv]

[userenv.shared]
AUTH_ALLOWED_EMAIL_DOMAIN = "aidigital.com"
AUTH_AUTHORIZED_PARTIES = "https://1fae4737-1001-4c87-b86a-e6c8de2a96a0-00-vkdhsp6p2d5t.kirk.replit.dev,http://localhost:5173,http://localhost:5000, https://1fae4737-1001-4c87-b86a-e6c8de2a96a0-00-vkdhsp6p2d5t.kirk.replit.dev:5173"
CLERK_PUBLISHABLE_KEY = "pk_test_bGl2aW5nLWluc2VjdC02MC5jbGVyay5hY2NvdW50cy5kZXYk"
PRD_CLERK_PUBLISHABLE_KEY = "pk_live_Y2xlcmsuYWlkaWdpdGFsLnRlY2gk"
PRD_AUTH_AUTHORIZED_PARTIES = " https://aiae-operational-hub.aidigital.tech"
PRD_APP_SECURITY_CSP_FRAME_ANCESTORS = "'self' https://aiae-operational-hub.aidigital.tech"
BIGQUERY_ENABLED = "true"
BIGQUERY_PROJECT_ID = "aiae-493511"
BIGQUERY_STUB_ENABLED = "false"
BIGQUERY_LOCATION = "US"
BIGQUERY_DATASET = "netsuite"